# Normalise text files to LF in the repository.
* text=auto eol=lf

# These must keep LF even when checked out on Windows. A shell script with
# CRLF endings fails with "bad interpreter", and Postgres and Deno both read
# these files on Linux.
*.sh    text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf

# Windows-native files keep CRLF.
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Never touched.
*.png   binary
*.jpg   binary
*.webp  binary
*.pdf   binary
*.woff2 binary
