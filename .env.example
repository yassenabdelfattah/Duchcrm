# ---------------------------------------------------------------------------
# Duch CRM - environment template
#
# Copy to .env and fill in. NEVER commit .env.
#
# Three different places consume these values, and they must not be mixed up:
#   [dashboard] browser code   -> only VITE_* vars, only the anon key
#   [edge]      Edge Functions -> set with: supabase secrets set KEY=value
#   [worker]    Cloudflare     -> set with: npx wrangler secret put KEY
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# [dashboard] Safe to ship to the browser. The anon key is public by design;
# Row Level Security is what protects the data, not the secrecy of this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# [edge][worker] Server-side only. This key BYPASSES Row Level Security.
# It must never appear in the dashboard app or in any VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Shopify ----------------------------------------------------------------
# [edge][worker] From your custom app in Shopify admin.
# See docs/shopify-app-setup.md for how to create it.
SHOPIFY_STORE_DOMAIN=duch-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07

# [edge] Used to verify the HMAC signature on incoming webhooks. Shown once
# when you create the webhook subscriptions.
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret

# [edge][worker] The numeric ID of the Shopify location the CRM mirrors.
# Find it with: docs/shopify-app-setup.md -> "Finding your location ID"
SHOPIFY_LOCATION_ID=00000000000

# --- Accurate Logistics -----------------------------------------------------
# [edge][worker] Phase 3. Left blank until their API docs are provided.
ACCURATE_BASE_URL=
ACCURATE_ACCESS_TOKEN=

# --- App behaviour ----------------------------------------------------------
# [dashboard] Default UI language on first load: 'ar' or 'en'
VITE_DEFAULT_LOCALE=ar
