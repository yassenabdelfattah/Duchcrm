{
  "name": "duch-crm",
  "private": true,
  "version": "0.1.0",
  "description": "Internal CRM and operations system for Duch streetwear",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @duch/dashboard",
    "build": "npm run build --workspace @duch/shared && npm run build --workspace @duch/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "functions:check": "deno check supabase/functions/*/index.ts",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > apps/dashboard/src/types/database.ts",
    "functions:serve": "supabase functions serve --no-verify-jwt",
    "worker:dev": "npm run dev --workspace @duch/worker"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
